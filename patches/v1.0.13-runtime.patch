+export async function getTestTabCounts(sourceId?: string): Promise<Record<string, number>> {
+  const query = queryString({ source_id: sourceId });
+  return getJson(`/api/v1/test-monitor/tabs${query ? `?${query}` : ""}`, {});
+}

--- a/services/api/app/database.py
+++ b/services/api/app/database.py
@@
+    def test_sheet_counts(self, source_id: str | None = None) -> dict[str, int]:
+        sql = "SELECT sheet_name, COUNT(*) AS total FROM test_records"
+        params: list[object] = []
+        if source_id:
+            sql += " WHERE source_id=?"
+            params.append(source_id)
+        sql += " GROUP BY sheet_name ORDER BY total DESC, sheet_name COLLATE NOCASE"
+        with self.connection() as connection:
+            rows = connection.execute(sql, params).fetchall()
+        return {str(row["sheet_name"]): int(row["total"]) for row in rows}
+
