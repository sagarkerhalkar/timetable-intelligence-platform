@@ Today stream cards
-.today-source-check span{display:flex;align-items:center;gap:8px;padding:9px 12px;border-radius:12px;background:rgba(236,248,251,.9);font-weight:800}
+.today-source-check .today-stream-link{display:flex;align-items:center;gap:8px;min-height:50px;padding:9px 12px;border:1px solid transparent;border-radius:12px;background:rgba(236,248,251,.9);font-weight:800;cursor:pointer;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease,background .16s ease}
